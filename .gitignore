# macOS
.DS_Store

# Rahasia & lingkungan (konfigurasi via env — konvensi spine AD)
.env
.env.*
!.env.example

# Claude Code — preferensi lokal per mesin
.claude/settings.local.json

# Node / Nuxt (seed untuk scaffold nanti)
node_modules/
.nuxt/
.output/
dist/
coverage/

# Vercel / Supabase lokal
.vercel/
supabase/.branches/
supabase/.temp/

# Log
*.log

# Playwright — artefak run & sesi auth tersimpan (mandate auth-session).
# `.auth/` = lokasi default storageDir bila konfigurasi global-setup terlewati.
test-results/
playwright-report/
blob-report/
playwright-logs/
tests/support/auth-sessions/
.auth/
