# ============================================================================
# snd-dash — contoh env (JANGAN mengisi rahasia nyata di repo; .env di-gitignore)
# Lingkungan hanya `local` (Supabase CLI/Docker) + `production` (Vercel +
# Supabase PG 17 via pooler) — AD-9. Konvensi: kredensial hanya via env.
# ============================================================================

# --- NuxtAuth (OAuth Google — smoke R-005) -----------------------------------
# Buat OAuth Client ID di Google Cloud Console (Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google untuk dev; produksi nanti
# https://<domain>/api/auth/callback/google).
NUXT_AUTH_SECRET=<openssl rand -base64 32>
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Origin yang dipercaya NuxtAuth — CATATAN: NuxtAuth 1.3.1 memakai nilai ini
# sebagai baseURL PENUH (harus menyertakan path /api/auth, tanpa trailing slash):
AUTH_ORIGIN=http://localhost:3000/api/auth

# --- Database (Supabase PG 17 via pooler — postgres.js) ----------------------
# Runtime (postgres.js / Drizzle). Local Supabase CLI default (Docker):
NUXT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# kredensial produksi: pooler Supabase region ap-southeast-1 (mode transaction,
# `prepare:false` sudah disetel di server/utils/db.ts).
# drizzle-kit memakai variabel ini (bukan prefix NUXT_):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Email keluar (Resend — wiring outbox AR-6) ------------------------------
# Keputusan pengguna spec 1.1 #3: wiring lengkap TANPA kredensial produksi
# dulu; verifikasi kirim nyata = gerbang pra-Story 1.5. Checklist From-domain
# + SPF/DKIM ada di README.md.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM=Sip & Dip <noreply@contoh.id>

# --- Cron (Vercel Cron → endpoint terproteksi, AD-9) --------------------------
# Vercel Cron mengirim `Authorization: Bearer ${CRON_SECRET}`; batas hari
# dihitung zona Asia/Jakarta DI DALAM endpoint (bukan jam trigger UTC).
NUXT_CRON_SECRET=<openssl rand -base64 32>

# --- Testing E2E/API (Playwright — scaffold TEA framework) ---------------------
# TEST_ENV memisahkan sesi auth yang di-persist auth-session (local|staging|production).
TEST_ENV=local
# BASE_URL untuk Playwright; kosong secara lokal agar webServer menjalankan
# `nuxt dev` otomatis. Di CI, isi untuk memakai deployment yang sudah berjalan.
BASE_URL=
# API_URL bila surface API berbeda dari BASE_URL (monolit Nuxt: sama).
API_URL=

