# PostgreSQL 17 (Supabase) connection string used by postgres.js + drizzle
DATABASE_URL=postgres://user:password@host:5432/dbname

# NuxtAuth (sidebase) — Google OAuth (task 18.3)
# AUTH_ORIGIN wajib untuk callback OAuth (produksi = origin publik aplikasi).
AUTH_ORIGIN=http://localhost:3000
# Rahasia sesi NextAuth — map ke runtimeConfig.authSecret via prefix NUXT_.
NUXT_AUTH_SECRET=change-me
# Kredensial Google OAuth — map ke runtimeConfig.google.{clientId,clientSecret}.
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Cron endpoint protection (AD-9) — map ke runtimeConfig.cronSecret via prefix NUXT_.
NUXT_CRON_SECRET=change-me
